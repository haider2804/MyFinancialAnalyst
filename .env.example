# ==============================================================================
# Environment Configuration for TypeSafe Jev + MT5 Quantitative Trading System
# ==============================================================================

# TypeSafe AI API Key for Jev System 1 Supervisor
# Sign up at https://typesafe.ai to obtain your key.
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL_VERSION=jev-latest

# MetaTrader 5 Terminal Configuration (Optional: leaving blank uses active terminal session)
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
# MT5_LOGIN=253620432
# MT5_PASSWORD=your_mt5_password
# MT5_SERVER=Exness-MT5Real34
MT5_TIMEOUT_MS=60000

# Trading Target & Timeframe
SYMBOL=GBPUSD
TIMEFRAME=M15
DEFAULT_VOLUME=0.01

# Operational Safety Mode (Set to False ONLY after verifying dry-run in demo)
DRY_RUN=True

# Risk Controls
MAX_SPREAD_PIPS=3.0
MAX_CONCURRENT_POSITIONS=2
MIN_RISK_ACCEPTABLE_PROB=0.85
MIN_MODEL_CONFIDENCE=0.60
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0

# Foundation Model Prior
CHRONOS_MODEL_NAME=amazon/chronos-bolt-tiny
CHRONOS_CONTEXT_LENGTH=128
FORECAST_HORIZON=5
POLL_INTERVAL_SECONDS=15
